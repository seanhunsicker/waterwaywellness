# Cloud sync (optional). Without these the app runs local-only.
# Use the same values as the Zingo UGC app (frequenthonorablebrains repo,
# src/Auth.jsx — SUPABASE_URL and SUPABASE_ANON), or your own Supabase
# project's Settings → API values. The anon key is safe to expose to the
# client; Row Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
